     SerialMM *uart0;
@@ -269,6 +274,19 @@ static void router_set_gpio_log(Object *obj, bool value, Error **errp)
     ROUTER_MACHINE(obj)->gpio_log = value;
 }
 
+static char *router_get_pcie_wifi(Object *obj, Error **errp)
+{
+    RouterState *b = ROUTER_MACHINE(obj);
+    return g_strdup(b->pcie_wifi ? b->pcie_wifi : "none");
+}
+
+static void router_set_pcie_wifi(Object *obj, const char *value, Error **errp)
+{
+    RouterState *b = ROUTER_MACHINE(obj);
+    g_free(b->pcie_wifi);
+    b->pcie_wifi = g_strdup(value);
