@@ -1009,6 +1027,24 @@ flash_done:
         sysbus_connect_irq(SYS_BUS_DEVICE(dev), i, spi_irq(b, 213 + i));
     }
 
+    /* PCIe slot (MT7987): the controller is there even without a card */
+    if (b->soc->pcie_base) {
+        const char *card = b->pcie_wifi;
+
+        if (!card || !strcmp(card, "none") || !*card) {
+            card = "";
+        } else if (!strcmp(card, "mt7992")) {
+            card = TYPE_MT7992_WIFI;
+        }   /* else: any QEMU PCI device type (tests) */
+        dev = qdev_new(TYPE_MT7987_PCIE);
+        qdev_prop_set_string(dev, "card", card);
+        sysbus_realize_and_unref(SYS_BUS_DEVICE(dev), &error_fatal);
+        memory_region_add_subregion_overlap(sysmem, b->soc->pcie_base,
+                sysbus_mmio_get_region(SYS_BUS_DEVICE(dev), 0), 20);
+        sysbus_connect_irq(SYS_BUS_DEVICE(dev), 0,
+                           spi_irq(b, b->soc->pcie_irq));
+    }
+
     qemu_register_reset(brom_reset, b);
 }
 
