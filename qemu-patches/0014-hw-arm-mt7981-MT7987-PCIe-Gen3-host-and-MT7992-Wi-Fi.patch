 } RouterSoC;
 
 static const hwaddr def_uart_base[] = {
@@ -155,6 +157,8 @@ static const RouterSoC soc_mt7987 = {
     .wdt_irq = 74,
     .dram_end = 0x140000000ULL, /* U-Boot probes up to 2 GB above the base */
     .topmisc_base = 0x10021000,
