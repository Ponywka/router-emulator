From 8bb0e86e2c4589ff7da49beef3bde5bd4647d78b Mon Sep 17 00:00:00 2001
From: ultras <stavultras@gmail.com>
Date: Tue, 6 Oct 2026 03:33:36 -0400
Subject: [PATCH 8/8] mt7981: W25N02KV 128-byte OOB; power on with reset held

- The 256 MB W25N02KV has 2048+128 byte pages. The parameter page said 64,
  so the stock Cudy BL2 (WR3000U) saw an NMBM signature written by
  U-Boot/Linux (spare 128) as 'configuration mismatch' and failed to load
  FIP on every boot after the first.
- reset-hold=MS machine option and pinctrl reset-hold-ms property: press
  reset now, release after MS of guest time (TFTP recovery in U-Boot).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 hw/arm/mt7981/cudy_wr3000x.c   | 29 ++++++++++++++++-
 hw/arm/mt7981/mt7981_pinctrl.c | 59 ++++++++++++++++++++++++++++++++++
 2 files changed, 87 insertions(+), 1 deletion(-)

diff --git a/hw/arm/mt7981/cudy_wr3000x.c b/hw/arm/mt7981/cudy_wr3000x.c
index 5ab93bf..f91fc19 100644
--- a/hw/arm/mt7981/cudy_wr3000x.c
+++ b/hw/arm/mt7981/cudy_wr3000x.c
@@ -11,6 +11,7 @@
  */
 
 #include "qemu/osdep.h"
+#include "qapi/visitor.h"
 #include "qemu/units.h"
 #include "qemu/error-report.h"
 #include "qemu/log.h"
@@ -100,8 +101,21 @@ struct WR3000XMachineState {
     DeviceState *eth;
     char *nand_dir;
     bool gpio_log;
+    uint32_t reset_hold;
 };
 
+static void wr3000x_get_reset_hold(Object *obj, Visitor *v, const char *name,
+                                   void *opaque, Error **errp)
+{
+    visit_type_uint32(v, name, &WR3000X_MACHINE(obj)->reset_hold, errp);
+}
+
+static void wr3000x_set_reset_hold(Object *obj, Visitor *v, const char *name,
+                                   void *opaque, Error **errp)
+{
+    visit_type_uint32(v, name, &WR3000X_MACHINE(obj)->reset_hold, errp);
+}
+
 static bool wr3000x_get_gpio_log(Object *obj, Error **errp)
 {
     return WR3000X_MACHINE(obj)->gpio_log;
@@ -435,7 +449,13 @@ static void wr3000x_init(MachineState *machine)
     dev = qdev_new(TYPE_MT7981_SPINAND);
     qdev_prop_set_uint32(dev, "blocks", bd->nand_blocks);
     if (bd->nand_blocks == 2048) {
-        qdev_prop_set_uint8(dev, "id2", 0x22);  /* W25N02KV */
+        /*
+         * W25N02KV: 2048 + 128 byte pages. The OOB size matters: the stock
+         * BL2 reads it from the parameter page while U-Boot/Linux use their
+         * ID table, and NMBM refuses to load when the two disagree.
+         */
+        qdev_prop_set_uint8(dev, "id2", 0x22);
+        qdev_prop_set_uint32(dev, "oob-size", 128);
     }
     dinfo = drive_get(IF_MTD, 0, 0);
     if (b->nand_dir) {
@@ -458,6 +478,7 @@ static void wr3000x_init(MachineState *machine)
     pinctrl = qdev_new(TYPE_MT7981_PINCTRL);
     object_property_add_child(OBJECT(machine), "pinctrl", OBJECT(pinctrl));
     qdev_prop_set_bit(pinctrl, "gpio-log", b->gpio_log);
+    qdev_prop_set_uint32(pinctrl, "reset-hold", b->reset_hold);
     sysbus_realize_and_unref(SYS_BUS_DEVICE(pinctrl), &error_fatal);
     sysbus_mmio_map(SYS_BUS_DEVICE(pinctrl), 0, 0x11d00000);
     sysbus_mmio_map(SYS_BUS_DEVICE(pinctrl), 1, 0x1000b000);
@@ -523,6 +544,12 @@ static void wr3000x_class_init(ObjectClass *oc, const void *data)
                                    wr3000x_set_gpio_log);
     object_class_property_set_description(oc, "gpio-log",
         "Print GPIO output changes (LEDs, resets) on stderr");
+    object_class_property_add(oc, "reset-hold", "uint32",
+                              wr3000x_get_reset_hold, wr3000x_set_reset_hold,
+                              NULL, NULL);
+    object_class_property_set_description(oc, "reset-hold",
+        "Power on with the reset button held for this many ms "
+        "(10000 = U-Boot TFTP recovery)");
 }
 
 static const TypeInfo wr3000x_machine_info = {
diff --git a/hw/arm/mt7981/mt7981_pinctrl.c b/hw/arm/mt7981/mt7981_pinctrl.c
index 3049cd9..4310850 100644
--- a/hw/arm/mt7981/mt7981_pinctrl.c
+++ b/hw/arm/mt7981/mt7981_pinctrl.c
@@ -9,6 +9,7 @@
  */
 
 #include "qemu/osdep.h"
+#include "qemu/timer.h"
 #include "qemu/log.h"
 #include "qemu/module.h"
 #include "qemu/error-report.h"
@@ -37,6 +38,8 @@ struct MT7981PinctrlState {
     uint32_t e_other[0x1000 / 4];
 
     uint32_t button_reset_pin, button_wps_pin;
+    uint32_t reset_hold_ms;     /* hold reset from power on (TFTP recovery) */
+    QEMUTimer *reset_release;
     bool gpio_log;
 };
 
@@ -291,6 +294,56 @@ static void button_set(Object *obj, Visitor *v, const char *name,
     set_input(s, pin, !pressed);    /* buttons are active low */
 }
 
+/*
+ * "Power on with reset held": press the reset button now and release it
+ * after @ms of guest (virtual) time, independent of emulation speed.
+ */
+static void reset_release_cb(void *opaque)
+{
+    MT7981PinctrlState *s = opaque;
+
+    set_input(s, s->button_reset_pin, true);
+}
+
+static void hold_reset(MT7981PinctrlState *s, uint32_t ms)
+{
+    set_input(s, s->button_reset_pin, false);
+    timer_mod(s->reset_release, qemu_clock_get_ms(QEMU_CLOCK_VIRTUAL) + ms);
+}
+
+static void hold_get(Object *obj, Visitor *v, const char *name,
+                     void *opaque, Error **errp)
+{
+    MT7981PinctrlState *s = MT7981_PINCTRL(obj);
+    uint32_t ms = 0;
+
+    if (timer_pending(s->reset_release)) {
+        ms = timer_expire_time_ns(s->reset_release) / SCALE_MS -
+             qemu_clock_get_ms(QEMU_CLOCK_VIRTUAL);
+    }
+    visit_type_uint32(v, name, &ms, errp);
+}
+
+static void hold_set(Object *obj, Visitor *v, const char *name,
+                     void *opaque, Error **errp)
+{
+    MT7981PinctrlState *s = MT7981_PINCTRL(obj);
+    uint32_t ms;
+
+    if (visit_type_uint32(v, name, &ms, errp)) {
+        hold_reset(s, ms);
+    }
+}
+
+static void pinctrl_realize(DeviceState *dev, Error **errp)
+{
+    MT7981PinctrlState *s = MT7981_PINCTRL(dev);
+
+    if (s->reset_hold_ms) {
+        hold_reset(s, s->reset_hold_ms);
+    }
+}
+
 static void pinctrl_init(Object *obj)
 {
     MT7981PinctrlState *s = MT7981_PINCTRL(obj);
@@ -314,18 +367,24 @@ static void pinctrl_init(Object *obj)
                         NULL, NULL);
     object_property_add(obj, "wps-button", "bool", button_get, button_set,
                         NULL, NULL);
+    /* write N: press reset now, release after N ms of guest time */
+    object_property_add(obj, "reset-hold-ms", "uint32", hold_get, hold_set,
+                        NULL, NULL);
+    s->reset_release = timer_new_ms(QEMU_CLOCK_VIRTUAL, reset_release_cb, s);
 }
 
 static const Property pinctrl_props[] = {
     DEFINE_PROP_UINT32("reset-pin", MT7981PinctrlState, button_reset_pin, 1),
     DEFINE_PROP_UINT32("wps-pin", MT7981PinctrlState, button_wps_pin, 0),
     DEFINE_PROP_BOOL("gpio-log", MT7981PinctrlState, gpio_log, false),
+    DEFINE_PROP_UINT32("reset-hold", MT7981PinctrlState, reset_hold_ms, 0),
 };
 
 static void pinctrl_class_init(ObjectClass *klass, const void *data)
 {
     DeviceClass *dc = DEVICE_CLASS(klass);
 
+    dc->realize = pinctrl_realize;
     device_class_set_legacy_reset(dc, pinctrl_reset);
     device_class_set_props(dc, pinctrl_props);
     dc->desc = "MT7981 GPIO + EINT";
