diff --git a/hw/arm/mt7981/spinor.c b/hw/arm/mt7981/spinor.c
new file mode 100644
index 0000000..189ddad
--- /dev/null
+++ b/hw/arm/mt7981/spinor.c
@@ -0,0 +1,440 @@
+/*
+ * Generic SPI-NOR flash model (default: Winbond W25Q128JV, 16 MiB, JEDEC ID
+ * ef 40 18, 4 KiB / 32 KiB / 64 KiB erase, 256 byte pages).
+ *
+ * The SPI master sends opcode, address and dummy bytes, then clocks the data
+ * phase, so the number of address/dummy bytes per opcode is fixed here:
+ *   03 read, 0b fast read, 3b 1-1-2, 6b 1-1-4 (1 dummy byte), bb 1-2-2
+ *   (1 byte mode/dummy), eb 1-4-4 (3 bytes mode/dummy), 02/32 page program,
+ *   20/52/d8 erase, c7/60 chip erase, 9f RDID, 05/35/15 RDSR1-3,
+ *   01/31/11 WRSR1-3, 06/04 WREN/WRDI, 5a SFDP (reads as erased: drivers
+ *   fall back to their ID tables), 66/99 reset, ab release power-down.
+ * The chip is always ready (WIP never set).
+ *
+ * Backing store: a directory of partition dumps (every file whose name
+ * contains "mtdN", concatenated in mtd order, written back on program /
+ * erase) or a raw image of the whole chip.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "qemu/osdep.h"
+#include "qemu/units.h"
+#include "qemu/log.h"
+#include "qemu/error-report.h"
+#include "qemu/module.h"
+#include "qapi/error.h"
+#include "hw/ssi/ssi.h"
+#include "hw/qdev-properties.h"
+#include "hw/qdev-properties-system.h"
+#include "system/block-backend.h"
+#include "mt7981.h"
+
+#define SR1_WIP     0x01
+#define SR1_WEL     0x02
+
+typedef struct NorSegment {
+    char *path;
+    uint64_t start;
+    uint64_t len;
+    int fd;
+} NorSegment;
+
+struct SpiNorState {
+    SSIPeripheral parent_obj;
+
+    BlockBackend *blk;
+    char *dir;
+    NorSegment *segs;
+    int nsegs;
+    uint8_t *storage;
+    uint32_t size_mb;
+    uint8_t id[3];
+
+    uint8_t sr[3];
+    int64_t dirty_lo, dirty_hi;     /* programmed bytes not yet saved */
+
+    /* transaction state */
+    uint8_t cmd;
+    uint32_t pos;
+    uint32_t addr;
+};
+
+static uint64_t nor_size(SpiNorState *s)
+{
+    return (uint64_t)s->size_mb << 20;
+}
+
+/* portable positioned I/O (no pread/pwrite on Windows) */
+static ssize_t file_pread(int fd, void *buf, size_t len, off_t off)
+{
+    if (lseek(fd, off, SEEK_SET) != off) {
+        return -1;
+    }
+    return read(fd, buf, len);
+}
+
+static ssize_t file_pwrite(int fd, const void *buf, size_t len, off_t off)
+{
+    if (lseek(fd, off, SEEK_SET) != off) {
+        return -1;
+    }
+    return write(fd, buf, len);
+}
+
+static void flush_range(SpiNorState *s, uint64_t off, uint64_t len)
+{
+    for (int i = 0; i < s->nsegs; i++) {
+        NorSegment *g = &s->segs[i];
+        uint64_t a = MAX(off, g->start);
+        uint64_t b = MIN(off + len, g->start + g->len);
+        if (a < b && g->fd >= 0 &&
+            file_pwrite(g->fd, s->storage + a, b - a, a - g->start) !=
+            (ssize_t)(b - a)) {
+            qemu_log_mask(LOG_GUEST_ERROR, "spinor: write to %s failed\n",
+                          g->path);
+        }
+    }
+    if (s->blk && blk_is_writable(s->blk) &&
+        blk_pwrite(s->blk, off, len, s->storage + off, 0) < 0) {
+        qemu_log_mask(LOG_GUEST_ERROR, "spinor: write to backing file failed\n");
+    }
+}
+
+static int seg_cmp(const void *a, const void *b)
+{
+    const NorSegment *x = a, *y = b;
+    return (int)x->start - (int)y->start;   /* start holds mtd index here */
+}
+
+static bool load_dir(SpiNorState *s, Error **errp)
+{
+    GDir *d = g_dir_open(s->dir, 0, NULL);
+    GRegex *re = g_regex_new("mtd([0-9]+)", 0, 0, NULL);
+    const char *name;
+    uint64_t pos = 0;
+
+    if (!d) {
+        error_setg(errp, "spinor: cannot open flash directory '%s'", s->dir);
+        return false;
+    }
+    while ((name = g_dir_read_name(d))) {
+        GMatchInfo *mi;
+        if (g_regex_match(re, name, 0, &mi)) {
+            g_autofree char *num = g_match_info_fetch(mi, 1);
+            s->segs = g_renew(NorSegment, s->segs, s->nsegs + 1);
+            s->segs[s->nsegs].path = g_build_filename(s->dir, name, NULL);
+            s->segs[s->nsegs].start = atoi(num);
+            s->segs[s->nsegs].fd = -1;
+            s->nsegs++;
+        }
+        g_match_info_free(mi);
+    }
+    g_dir_close(d);
+    g_regex_unref(re);
+    if (!s->nsegs) {
+        error_setg(errp, "spinor: no *mtdN* files in '%s'", s->dir);
+        return false;
+    }
+    qsort(s->segs, s->nsegs, sizeof(NorSegment), seg_cmp);
+    for (int i = 1; i < s->nsegs; i++) {
+        if (s->segs[i].start == s->segs[i - 1].start) {
+            error_setg(errp, "spinor: two files for mtd%d: %s and %s",
+                       (int)s->segs[i].start, s->segs[i - 1].path,
+                       s->segs[i].path);
+            return false;
+        }
+    }
+    for (int i = 0; i < s->nsegs; i++) {
+        NorSegment *g = &s->segs[i];
+        struct stat st;
+
+        g->fd = open(g->path, O_RDWR | O_BINARY);
+        if (g->fd < 0) {
+            g->fd = open(g->path, O_RDONLY | O_BINARY);
+            warn_report("spinor: %s is read-only, writes are not saved",
+                        g->path);
+        }
+        if (g->fd < 0 || fstat(g->fd, &st) < 0) {
+            error_setg_errno(errp, errno, "spinor: cannot open %s", g->path);
+            return false;
+        }
+        g->start = pos;
+        g->len = st.st_size;
+        if (pos + g->len > nor_size(s)) {
+            error_setg(errp, "spinor: partition files exceed the flash size"
+                       " (%" PRIu64 " bytes) at %s", nor_size(s), g->path);
+            return false;
+        }
+        if (file_pread(g->fd, s->storage + pos, g->len, 0) != (ssize_t)g->len) {
+            error_setg(errp, "spinor: read error on %s", g->path);
+            return false;
+        }
+        info_report("NOR 0x%08" PRIx64 "-0x%08" PRIx64 ": %s", g->start,
+                    g->start + g->len, g->path);
+        pos += g->len;
+    }
+    if (pos < nor_size(s)) {
+        warn_report("spinor: partition files cover only 0x%" PRIx64
+                    " of 0x%" PRIx64 " bytes; the rest is erased and not "
+                    "saved", pos, nor_size(s));
+    }
+    return true;
+}
+
+/* Data read helper used by the BootROM emulation. */
+void spinor_read(SpiNorState *s, uint64_t off, void *buf, size_t len)
+{
+    uint8_t *out = buf;
+
+    for (size_t i = 0; i < len; i++) {
+        out[i] = off + i < nor_size(s) ? s->storage[off + i] : 0xff;
+    }
+}
+
+/* address bytes and mode/dummy bytes after the opcode */
+static void cmd_layout(uint8_t cmd, int *alen, int *dummy)
+{
+    *alen = 0;
+    *dummy = 0;
+    switch (cmd) {
+    case 0x03:              /* read */
+    case 0x02: case 0x32:   /* page program (1-1-1, 1-1-4) */
+    case 0x20: case 0x52: case 0xd8:    /* erase 4K / 32K / 64K */
+        *alen = 3;
+        break;
+    case 0x0b: case 0x3b: case 0x6b:    /* fast read 1-1-1/2/4 */
+    case 0xbb:                          /* 1-2-2: mode byte */
+        *alen = 3;
+        *dummy = 1;
+        break;
+    case 0xeb:                          /* 1-4-4: mode + 4 dummy cycles */
+        *alen = 3;
+        *dummy = 3;
+        break;
+    case 0x5a:                          /* SFDP: 3 address + 1 dummy */
+        *alen = 3;
+        *dummy = 1;
+        break;
+    }
+}
+
+static void do_erase(SpiNorState *s, uint32_t addr, uint32_t len)
+{
+    addr &= ~(len - 1);
+    if (!(s->sr[0] & SR1_WEL) || addr >= nor_size(s)) {
+        return;
+    }
+    len = MIN(len, nor_size(s) - addr);
+    memset(s->storage + addr, 0xff, len);
+    flush_range(s, addr, len);
+    s->sr[0] &= ~SR1_WEL;
+}
+
+static uint32_t spinor_transfer(SSIPeripheral *dev, uint32_t val)
+{
+    SpiNorState *s = MT7981_SPINOR(dev);
+    uint32_t pos = s->pos++;
+    int alen, dummy;
+
+    if (pos == 0) {
+        s->cmd = val;
+        s->addr = 0;
+        switch (s->cmd) {
+        case 0x06:
+            s->sr[0] |= SR1_WEL;
+            break;
+        case 0x04:
+            s->sr[0] &= ~SR1_WEL;
+            break;
+        case 0xc7: case 0x60:           /* chip erase */
+            if (s->sr[0] & SR1_WEL) {
+                memset(s->storage, 0xff, nor_size(s));
+                flush_range(s, 0, nor_size(s));
+                s->sr[0] &= ~SR1_WEL;
+            }
+            break;
+        case 0x66: case 0x99:           /* reset enable / reset */
+            s->sr[0] &= ~SR1_WEL;
+            break;
+        }
+        return 0xff;
+    }
+
+    switch (s->cmd) {
+    case 0x9f:                          /* RDID */
+        return s->id[(pos - 1) % 3];
+    case 0x05: case 0x35: case 0x15:    /* RDSR1/2/3 */
+        return s->sr[s->cmd == 0x05 ? 0 : s->cmd == 0x35 ? 1 : 2];
+    case 0x01:                          /* WRSR: SR1 [, SR2] */
+        if (s->sr[0] & SR1_WEL) {
+            if (pos == 1) {
+                s->sr[0] = (val & ~(SR1_WIP | SR1_WEL)) | SR1_WEL;
+            } else if (pos == 2) {
+                s->sr[1] = val;
+            }
+        }
+        return 0xff;
+    case 0x31: case 0x11:               /* WRSR2 / WRSR3 */
+        if (pos == 1 && s->sr[0] & SR1_WEL) {
+            s->sr[s->cmd == 0x31 ? 1 : 2] = val;
+        }
+        return 0xff;
+    case 0xab:                          /* release power-down: device ID */
+        return pos >= 4 ? 0x17 : 0xff;
+    }
+
+    cmd_layout(s->cmd, &alen, &dummy);
+    if (!alen) {
+        if (pos == 1) {
+            qemu_log_mask(LOG_UNIMP, "spinor: unknown command 0x%02x\n", s->cmd);
+        }
+        return 0xff;
+    }
+    if (pos <= alen) {
+        s->addr = (s->addr << 8) | (val & 0xff);
+        if (pos == alen) {
+            switch (s->cmd) {
+            case 0x20:
+                do_erase(s, s->addr, 4 * KiB);
+                break;
+            case 0x52:
+                do_erase(s, s->addr, 32 * KiB);
+                break;
+            case 0xd8:
+                do_erase(s, s->addr, 64 * KiB);
+                break;
+            }
+        }
+        return 0xff;
+    }
+    if (pos <= (uint32_t)(alen + dummy)) {
+        return 0xff;
+    }
+
+    switch (s->cmd) {
+    case 0x5a:                          /* no SFDP tables */
+        return 0xff;
+    case 0x02: case 0x32: {             /* page program, wraps in the page */
+        uint32_t page = s->addr & ~0xffu;
+        uint32_t a = page | ((s->addr + pos - alen - 1) & 0xff);
+        if (s->sr[0] & SR1_WEL && a < nor_size(s)) {
+            s->storage[a] &= val;       /* NOR programming clears bits */
+            s->dirty_lo = s->dirty_lo < 0 ? a : MIN(s->dirty_lo, a);
+            s->dirty_hi = MAX(s->dirty_hi, (int64_t)a + 1);
+        }
+        return 0xff;
+    }
+    default: {                          /* reads */
+        uint64_t a = (uint64_t)s->addr + pos - alen - dummy - 1;
+        return a < nor_size(s) ? s->storage[a] : 0xff;
+    }
+    }
+}
+
+static int spinor_set_cs(SSIPeripheral *dev, bool select)
+{
+    SpiNorState *s = MT7981_SPINOR(dev);
+
+    if (select) {
+        s->pos = 0;
+        return 0;
+    }
+    if (s->dirty_lo >= 0) {             /* page program done: save it */
+        flush_range(s, s->dirty_lo, s->dirty_hi - s->dirty_lo);
+        s->dirty_lo = -1;
+        s->dirty_hi = 0;
+    }
+    switch (s->cmd) {                   /* write commands end: WEL off */
+    case 0x02: case 0x32: case 0x01: case 0x31: case 0x11:
+        if (s->pos > 1) {
+            s->sr[0] &= ~SR1_WEL;
+        }
+        break;
+    }
+    return 0;
+}
+
+static void spinor_realize(SSIPeripheral *dev, Error **errp)
+{
+    SpiNorState *s = MT7981_SPINOR(dev);
+    uint64_t size = nor_size(s);
+
+    s->storage = g_malloc(size);
+    memset(s->storage, 0xff, size);
+    if (s->dir && s->blk) {
+        error_setg(errp, "spinor: use either a drive or a directory");
+        return;
+    }
+    if (s->dir) {
+        load_dir(s, errp);
+        return;
+    }
+    if (s->blk) {
+        uint64_t perm = BLK_PERM_CONSISTENT_READ |
+                        (blk_supports_write_perm(s->blk) ? BLK_PERM_WRITE : 0);
+        int64_t blen;
+
+        if (blk_set_perm(s->blk, perm, BLK_PERM_ALL, errp) < 0) {
+            return;
+        }
+        blen = blk_getlength(s->blk);
+        if (blen < 0 || (uint64_t)blen != size) {
+            error_setg(errp, "spinor: backing file must be exactly %" PRIu64
+                       " bytes", size);
+            return;
+        }
+        if (blk_pread(s->blk, 0, size, s->storage, 0) < 0) {
+            error_setg(errp, "spinor: failed to read backing file");
+        }
+    }
+}
+
+static void spinor_reset(DeviceState *dev)
+{
+    SpiNorState *s = MT7981_SPINOR(dev);
+
+    s->sr[0] = 0;
+    s->sr[1] = 0x02;    /* QE set, as on boards wired for quad I/O */
+    s->sr[2] = 0;
+    s->pos = 0;
+    s->dirty_lo = -1;
+    s->dirty_hi = 0;
+}
+
+static const Property spinor_props[] = {
+    DEFINE_PROP_DRIVE("drive", SpiNorState, blk),
+    DEFINE_PROP_STRING("dir", SpiNorState, dir),
+    DEFINE_PROP_UINT32("size-mb", SpiNorState, size_mb, 16),
+    DEFINE_PROP_UINT8("id0", SpiNorState, id[0], 0xef),
+    DEFINE_PROP_UINT8("id1", SpiNorState, id[1], 0x40),
+    DEFINE_PROP_UINT8("id2", SpiNorState, id[2], 0x18),
+};
+
+static void spinor_class_init(ObjectClass *klass, const void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+    SSIPeripheralClass *k = SSI_PERIPHERAL_CLASS(klass);
+
+    k->realize = spinor_realize;
+    k->transfer = spinor_transfer;
+    k->set_cs = spinor_set_cs;
+    k->cs_polarity = SSI_CS_LOW;
+    device_class_set_legacy_reset(dc, spinor_reset);
+    device_class_set_props(dc, spinor_props);
+    dc->desc = "SPI-NOR flash";
+}
+
+static const TypeInfo spinor_info = {
+    .name = TYPE_MT7981_SPINOR,
+    .parent = TYPE_SSI_PERIPHERAL,
+    .instance_size = sizeof(SpiNorState),
+    .class_init = spinor_class_init,
+};
+
+static void spinor_register_types(void)
+{
+    type_register_static(&spinor_info);
+}
+
+type_init(spinor_register_types)
