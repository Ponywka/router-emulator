diff --git a/hw/arm/mt7981/mt7981_msdc.c b/hw/arm/mt7981/mt7981_msdc.c
new file mode 100644
index 0000000..b2d3127
--- /dev/null
+++ b/hw/arm/mt7981/mt7981_msdc.c
@@ -0,0 +1,385 @@
+/*
+ * MediaTek MSDC SD/MMC host controller (mtk-sd), as on the MT7986 /
+ * MT7981, with the card on a QEMU SD bus (eMMC: TYPE_EMMC).
+ *
+ * Covers what TF-A, U-Boot and Linux use: commands with R1/R1b/R2/R3
+ * responses, auto CMD23 / CMD12, PIO data through the 128-byte FIFO (TF-A,
+ * U-Boot) and descriptor DMA (GPD + BD chain, Linux).  Timing, sampling
+ * and tuning registers are plain storage: the card is always in sync.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "qemu/osdep.h"
+#include "qemu/log.h"
+#include "qemu/module.h"
+#include "hw/irq.h"
+#include "hw/sd/sd.h"
+#include "system/dma.h"
+#include "system/address-spaces.h"
+#include "mt7981.h"
+
+#define MSDC_CFG        0x00
+#define MSDC_PS         0x08
+#define MSDC_INT        0x0c
+#define MSDC_INTEN      0x10
+#define MSDC_FIFOCS     0x14
+#define MSDC_TXDATA     0x18
+#define MSDC_RXDATA     0x1c
+#define SDC_CMD         0x34
+#define SDC_ARG         0x38
+#define SDC_STS         0x3c
+#define SDC_RESP0       0x40
+#define SDC_BLK_NUM     0x50
+#define SDC_ACMD_RESP   0x80
+#define DMA_SA_H4BIT    0x8c
+#define MSDC_DMA_SA     0x90
+#define MSDC_DMA_CA     0x94
+#define MSDC_DMA_CTRL   0x98
+#define MSDC_DMA_CFG    0x9c
+#define MSDC_NREGS      (0x1000 / 4)
+
+#define CFG_RST         BIT(2)
+#define CFG_PIO         BIT(3)
+#define CFG_CKSTB       BIT(7)
+
+#define INT_ACMDRDY     BIT(3)
+#define INT_ACMDTMO     BIT(4)
+#define INT_CMDRDY      BIT(8)
+#define INT_CMDTMO      BIT(9)
+#define INT_XFER_COMPL  BIT(12)
+
+#define FIFOCS_CLR      BIT(31)
+#define FIFO_SIZE       128
+
+#define DMA_CTRL_START  BIT(0)
+#define DMA_CTRL_STOP   BIT(1)
+
+#define GPD_BDP         BIT(1)
+#define BD_EOL          BIT(0)
+
+struct MT7981MsdcState {
+    SysBusDevice parent_obj;
+    MemoryRegion iomem;
+    qemu_irq irq;
+    SDBus sdbus;
+
+    uint32_t regs[MSDC_NREGS];
+    uint32_t xfer_left;     /* data bytes of the current command */
+    bool xfer_write;
+    bool auto_stop;         /* auto CMD12 once the data is through */
+};
+
+static void msdc_update_irq(MT7981MsdcState *s)
+{
+    qemu_set_irq(s->irq, !!(s->regs[MSDC_INT / 4] & s->regs[MSDC_INTEN / 4]));
+}
+
+static void msdc_raise(MT7981MsdcState *s, uint32_t bits)
+{
+    s->regs[MSDC_INT / 4] |= bits;
+    msdc_update_irq(s);
+}
+
+/* send one command; false: no response (timeout) */
+static bool msdc_command(MT7981MsdcState *s, uint8_t cmd, uint32_t arg,
+                         int rsptyp, uint32_t *resp_out)
+{
+    SDRequest req = { .cmd = cmd, .arg = arg };
+    uint8_t resp[16];
+    size_t rlen = sdbus_do_command(&s->sdbus, &req, resp, sizeof(resp));
+
+    if (rsptyp == 0) {
+        return true;
+    }
+    if (rsptyp == 2) {                  /* R2: 136 bits */
+        if (rlen != 16) {
+            return false;
+        }
+        for (int i = 0; i < 4; i++) {
+            resp_out[i] = ldl_be_p(&resp[12 - 4 * i]);
+        }
+        return true;
+    }
+    if (rlen != 4) {
+        return false;
+    }
+    resp_out[0] = ldl_be_p(resp);
+    return true;
+}
+
+static void msdc_auto_stop(MT7981MsdcState *s)
+{
+    uint32_t r[4];
+
+    if (!s->auto_stop) {
+        return;
+    }
+    s->auto_stop = false;
+    if (msdc_command(s, 12, 0, 7, r)) {
+        s->regs[SDC_ACMD_RESP / 4] = r[0];
+        msdc_raise(s, INT_ACMDRDY);
+    } else {
+        msdc_raise(s, INT_ACMDTMO);
+    }
+}
+
+static void msdc_xfer_done(MT7981MsdcState *s)
+{
+    msdc_auto_stop(s);
+    msdc_raise(s, INT_XFER_COMPL);
+}
+
+/*
+ * SDC_CMD: vol_swt << 30 | auto_cmd << 28 | blklen << 16 | stop << 14 |
+ * rw << 13 | dtype << 11 | rsptyp << 7 | opcode
+ */
+static void msdc_start_command(MT7981MsdcState *s, uint32_t raw)
+{
+    uint8_t cmd = raw & 0x3f;
+    int rsptyp = (raw >> 7) & 7;
+    int dtype = (raw >> 11) & 3;
+    int autocmd = (raw >> 28) & 3;
+    uint32_t blklen = (raw >> 16) & 0xfff;
+    uint32_t blocks = s->regs[SDC_BLK_NUM / 4];
+    uint32_t r[4] = { 0 };
+
+    s->xfer_left = 0;
+    s->auto_stop = false;
+    if (autocmd == 2 && dtype) {        /* auto CMD23: block count first */
+        if (msdc_command(s, 23, blocks, 1, r)) {
+            s->regs[SDC_ACMD_RESP / 4] = r[0];
+            msdc_raise(s, INT_ACMDRDY);
+        } else {
+            msdc_raise(s, INT_ACMDTMO);
+        }
+    }
+    if (!msdc_command(s, cmd, s->regs[SDC_ARG / 4], rsptyp, r)) {
+        qemu_log_mask(LOG_GUEST_ERROR, "mt7981-msdc: CMD%d arg 0x%x: no "
+                      "response\n", cmd, s->regs[SDC_ARG / 4]);
+        msdc_raise(s, INT_CMDTMO);
+        return;
+    }
+    for (int i = 0; i < 4; i++) {
+        s->regs[SDC_RESP0 / 4 + i] = r[i];
+    }
+    if (dtype) {
+        if (!blklen) {
+            blklen = 0x200;
+        }
+        s->xfer_left = blklen * (dtype == 1 ? 1 : MAX(blocks, 1));
+        s->xfer_write = raw & BIT(13);
+        s->auto_stop = autocmd == 1;
+    }
+    msdc_raise(s, INT_CMDRDY);
+}
+
+/*
+ * Linux: one GPD with BDP set points at a chain of BDs, each a buffer
+ * (address with 4 high bits in bd_info[31:28], length in [23:0]).
+ */
+static void msdc_dma_start(MT7981MsdcState *s)
+{
+    uint64_t gpd = ((uint64_t)(s->regs[DMA_SA_H4BIT / 4] & 0xf) << 32) |
+                   s->regs[MSDC_DMA_SA / 4];
+    uint32_t g[4], b[4];
+    uint64_t bd;
+    g_autofree uint8_t *buf = NULL;
+    int guard = 4096;
+
+    dma_memory_read(&address_space_memory, gpd, g, sizeof(g),
+                    MEMTXATTRS_UNSPECIFIED);
+    for (int i = 0; i < 4; i++) {
+        g[i] = le32_to_cpu(g[i]);
+    }
+    if (!(g[0] & GPD_BDP)) {
+        qemu_log_mask(LOG_UNIMP, "mt7981-msdc: GPD without BDs\n");
+        msdc_xfer_done(s);
+        return;
+    }
+    bd = ((uint64_t)((g[0] >> 28) & 0xf) << 32) | g[2];
+    while (s->xfer_left && guard--) {
+        uint64_t addr;
+        uint32_t len;
+
+        dma_memory_read(&address_space_memory, bd, b, sizeof(b),
+                        MEMTXATTRS_UNSPECIFIED);
+        for (int i = 0; i < 4; i++) {
+            b[i] = le32_to_cpu(b[i]);
+        }
+        addr = ((uint64_t)((b[0] >> 28) & 0xf) << 32) | b[2];
+        len = MIN(b[3] & 0xffffff, s->xfer_left);
+        buf = g_realloc(buf, MAX(len, 1));
+        if (s->xfer_write) {
+            dma_memory_read(&address_space_memory, addr, buf, len,
+                            MEMTXATTRS_UNSPECIFIED);
+            sdbus_write_data(&s->sdbus, buf, len);
+        } else {
+            sdbus_read_data(&s->sdbus, buf, len);
+            dma_memory_write(&address_space_memory, addr, buf, len,
+                             MEMTXATTRS_UNSPECIFIED);
+        }
+        s->xfer_left -= len;
+        if (b[0] & BD_EOL) {
+            break;
+        }
+        bd = ((uint64_t)((b[0] >> 24) & 0xf) << 32) | b[1];
+    }
+    s->xfer_left = 0;
+    msdc_xfer_done(s);
+}
+
+static void msdc_reset_fifo(MT7981MsdcState *s)
+{
+    s->xfer_left = 0;
+    s->auto_stop = false;
+}
+
+static uint64_t msdc_read(void *opaque, hwaddr addr, unsigned size)
+{
+    MT7981MsdcState *s = opaque;
+    uint32_t v = s->regs[(addr & ~3) / 4];
+
+    switch (addr & ~3) {
+    case MSDC_CFG:
+        return (v & ~CFG_RST) | CFG_CKSTB;
+    case MSDC_PS:   /* DAT0..7 and CMD high: card not busy */
+        return (v & 0xffff) | (0xff << 16) | BIT(24);
+    case MSDC_FIFOCS:
+        if (s->xfer_left && !s->xfer_write && (s->regs[MSDC_CFG / 4] & CFG_PIO)) {
+            return MIN(s->xfer_left, FIFO_SIZE);
+        }
+        return 0;
+    case MSDC_RXDATA: {
+        uint32_t data = 0;
+        uint32_t n = MIN(size, s->xfer_left);
+
+        if (s->xfer_write || !n) {
+            return 0;
+        }
+        sdbus_read_data(&s->sdbus, &data, n);
+        s->xfer_left -= n;
+        if (!s->xfer_left) {
+            msdc_xfer_done(s);
+        }
+        return le32_to_cpu(data);
+    }
+    case SDC_STS:
+    case MSDC_DMA_CFG:          /* DMA not active */
+        return 0;
+    case MSDC_DMA_CTRL:
+        return v & ~(DMA_CTRL_START | DMA_CTRL_STOP);
+    }
+    if (size < 4) {
+        v = (v >> ((addr & 3) * 8)) & ((1ULL << (size * 8)) - 1);
+    }
+    return v;
+}
+
+static void msdc_write(void *opaque, hwaddr addr, uint64_t val,
+                       unsigned size)
+{
+    MT7981MsdcState *s = opaque;
+    uint32_t v = val;
+    hwaddr a = addr & ~3;
+
+    switch (a) {
+    case MSDC_CFG:
+        if (v & CFG_RST) {
+            msdc_reset_fifo(s);
+        }
+        break;
+    case MSDC_INT:      /* write 1 to clear */
+        s->regs[a / 4] &= ~v;
+        msdc_update_irq(s);
+        return;
+    case MSDC_INTEN:
+        s->regs[a / 4] = v;
+        msdc_update_irq(s);
+        return;
+    case MSDC_FIFOCS:
+        if (v & FIFOCS_CLR) {
+            msdc_reset_fifo(s);
+        }
+        return;
+    case MSDC_TXDATA: {
+        uint32_t data = cpu_to_le32(v);
+        uint32_t n = MIN(size, s->xfer_left);
+
+        if (!s->xfer_write || !n) {
+            return;
+        }
+        sdbus_write_data(&s->sdbus, &data, n);
+        s->xfer_left -= n;
+        if (!s->xfer_left) {
+            msdc_xfer_done(s);
+        }
+        return;
+    }
+    case SDC_CMD:
+        s->regs[a / 4] = v;
+        msdc_start_command(s, v);
+        return;
+    case MSDC_DMA_CTRL:
+        s->regs[a / 4] = v & ~(DMA_CTRL_START | DMA_CTRL_STOP);
+        if ((v & DMA_CTRL_START) && s->xfer_left) {
+            msdc_dma_start(s);
+        }
+        return;
+    }
+    if (size < 4) {
+        uint32_t sh = (addr & 3) * 8, m = ((1ULL << (size * 8)) - 1) << sh;
+        v = (s->regs[a / 4] & ~m) | ((v << sh) & m);
+    }
+    s->regs[a / 4] = v;
+}
+
+static const MemoryRegionOps msdc_ops = {
+    .read = msdc_read,
+    .write = msdc_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid = { .min_access_size = 1, .max_access_size = 4 },
+};
+
+static void msdc_reset(DeviceState *dev)
+{
+    MT7981MsdcState *s = MT7981_MSDC(dev);
+
+    memset(s->regs, 0, sizeof(s->regs));
+    msdc_reset_fifo(s);
+    qemu_irq_lower(s->irq);
+}
+
+static void msdc_init(Object *obj)
+{
+    MT7981MsdcState *s = MT7981_MSDC(obj);
+
+    qbus_init(&s->sdbus, sizeof(s->sdbus), TYPE_SD_BUS, DEVICE(s), "sd-bus");
+    memory_region_init_io(&s->iomem, obj, &msdc_ops, s, "mt7981-msdc",
+                          0x1000);
+    sysbus_init_mmio(SYS_BUS_DEVICE(obj), &s->iomem);
+    sysbus_init_irq(SYS_BUS_DEVICE(obj), &s->irq);
+}
+
+static void msdc_class_init(ObjectClass *klass, const void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+
+    device_class_set_legacy_reset(dc, msdc_reset);
+    dc->desc = "MediaTek MSDC SD/MMC host";
+}
+
+static const TypeInfo msdc_info = {
+    .name = TYPE_MT7981_MSDC,
+    .parent = TYPE_SYS_BUS_DEVICE,
+    .instance_size = sizeof(MT7981MsdcState),
+    .instance_init = msdc_init,
+    .class_init = msdc_class_init,
+};
+
+static void msdc_register_types(void)
+{
+    type_register_static(&msdc_info);
+}
+
+type_init(msdc_register_types)
