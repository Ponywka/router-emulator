+/*
+ * eMMC on MSDC0 (0x11230000, SPI 143): one raw image holding boot0, boot1
+ * (emmc-boot MB each) and the user area, size a power of 2.  From
+ * -drive if=sd, or the first *.img file of the flash folder.
+ */
+static void create_emmc(RouterState *b)
+{
+    DeviceState *msdc, *card;
+    DriveInfo *dinfo = drive_get(IF_SD, 0, 0);
+    Error *err = NULL;
+
+    msdc = qdev_new(TYPE_MT7981_MSDC);
+    sysbus_realize_and_unref(SYS_BUS_DEVICE(msdc), &error_fatal);
+    sysbus_mmio_map(SYS_BUS_DEVICE(msdc), 0, 0x11230000);
+    sysbus_connect_irq(SYS_BUS_DEVICE(msdc), 0, spi_irq(b, 143));
+
+    if (dinfo) {
