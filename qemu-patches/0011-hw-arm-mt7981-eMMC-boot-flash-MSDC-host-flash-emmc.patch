 hw/arm/mt7981/mt7981_msdc.c   | 385 ++++++++++++++++++++++++++++++++++
 hw/arm/mt7981/mt7981_router.c | 132 ++++++++++--
 5 files changed, 510 insertions(+), 13 deletions(-)
 create mode 100644 hw/arm/mt7981/mt7981_msdc.c

