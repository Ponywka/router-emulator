+/*
+ * MT7981 GPHY analog calibration: setting DA_CALIN_FLAG (VEND1 0x17c bit0)
+ * completes a comparator cycle (0x17b bit0); the comparator (0x17a bit 8)
+ * trips once the searched TX-VCM reserve (RXADC_CTRL_RG9 [3:0]) >= 4.
+ */
+static uint16_t phy_mmd_read(EthPhy *p, int dev, int reg)
+{
+    uint32_t v = ht_get(p->mmd, (dev << 16) | reg, 0);
+
+    if (p->type == PHY_MT7981 && dev == 0x1e) {
+        if (reg == 0x17b) {
+            return ht_get(p->mmd, (0x1e << 16) | 0x17c, 0) & 1;
+        }
+        if (reg == 0x17a) {
+            uint32_t rsv = ht_get(p->mmd, (0x1e << 16) | 0xc8, 0) & 0xf;
+            return (v & ~0x100) | (rsv >= 4 ? 0x100 : 0);
+        }
+    }
+    return v;
+}
+
 static uint16_t phy_c22_read(EthPhy *p, int reg)
