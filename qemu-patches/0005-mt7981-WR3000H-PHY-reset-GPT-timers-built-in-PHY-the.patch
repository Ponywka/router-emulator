     default:
-        known = dramc_nao_read(s, a & ~3, &v);
+        known = gpt_read(s, a & ~3, &v) || dramc_nao_read(s, a & ~3, &v);
     }
 
     if (in(a, 0x10230000, 0x20000) || in(a, 0x10200000, 0x30000)) {
@@ -229,6 +316,9 @@ static void sysctl_write(void *opaque, hwaddr offset, uint64_t val,
