-            return ht_get(p->mmd, ((p->mmd_ctrl & 0x1f) << 16) | p->mmd_addr, 0);
+            return phy_mmd_read(p, p->mmd_ctrl & 0x1f, p->mmd_addr);
         }
         return p->mmd_addr;
     case 0x1f:
@@ -336,12 +365,16 @@ static uint16_t phy_c45_read(EthPhy *p, int dev, int reg)
