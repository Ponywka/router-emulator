diff --git a/net/pcap.c b/net/pcap.c
new file mode 100644
index 0000000..b418bb7
--- /dev/null
+++ b/net/pcap.c
@@ -0,0 +1,338 @@
+/*
+ * QEMU network backend: host adapter access through libpcap / Npcap.
+ *
+ * Frames from the guest are injected on the host adapter, frames seen on
+ * the adapter (promiscuous mode) are delivered to the guest - the same
+ * "bridged adapter" model desktop hypervisors use.  libpcap (Linux) or
+ * Npcap's wpcap.dll (Windows) is loaded at run time, so QEMU does not
+ * depend on it unless this backend is used.
+ *
+ *   -netdev pcap,id=wan,ifname=<pcap device name | index | list>
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "qemu/osdep.h"
+#include "qemu/error-report.h"
+#include "qemu/main-loop.h"
+#include "qemu/thread.h"
+#include "qapi/error.h"
+#include "qapi/qapi-types-net.h"
+#include "net/net.h"
+#include "clients.h"
+
+#ifdef _WIN32
+#include <windows.h>
+#else
+#include <dlfcn.h>
+#endif
+
+#define PCAP_ERRBUF_SIZE 256
+#define PCAP_SNAPLEN     65536
+#define RECENT_MACS      16
+
+typedef struct pcap pcap_t;
+struct pcap_pkthdr {
+    struct { long tv_sec; long tv_usec; } ts;
+    uint32_t caplen;
+    uint32_t len;
+};
+typedef struct pcap_if {
+    struct pcap_if *next;
+    char *name;
+    char *description;
+    void *addresses;
+    uint32_t flags;
+} pcap_if_t;
+
+static struct {
+    bool loaded;
+    pcap_t *(*create)(const char *, char *);
+    int (*set_snaplen)(pcap_t *, int);
+    int (*set_promisc)(pcap_t *, int);
+    int (*set_timeout)(pcap_t *, int);
+    int (*set_immediate_mode)(pcap_t *, int);
+    int (*activate)(pcap_t *);
+    int (*setnonblock)(pcap_t *, int, char *);
+    int (*next_ex)(pcap_t *, struct pcap_pkthdr **, const unsigned char **);
+    int (*sendpacket)(pcap_t *, const unsigned char *, int);
+    void (*close)(pcap_t *);
+    char *(*geterr)(pcap_t *);
+    int (*findalldevs)(pcap_if_t **, char *);
+    void (*freealldevs)(pcap_if_t *);
+#ifdef _WIN32
+    HANDLE (*getevent)(pcap_t *);
+    int (*setmintocopy)(pcap_t *, int);
+#else
+    int (*get_selectable_fd)(pcap_t *);
+#endif
+} pc;
+
+static bool pcap_load(Error **errp)
+{
+    void *h;
+
+    if (pc.loaded) {
+        return true;
+    }
+#ifdef _WIN32
+    /* Npcap installs into System32\Npcap */
+    {
+        char dir[MAX_PATH];
+        UINT n = GetSystemDirectoryA(dir, sizeof(dir));
+        if (n && n < sizeof(dir) - 8) {
+            strcat(dir, "\\Npcap");
+            SetDllDirectoryA(dir);
+        }
+    }
+    h = LoadLibraryA("wpcap.dll");
+#define SYM(n) GetProcAddress((HMODULE)h, n)
+    if (!h) {
+        error_setg(errp, "pcap: wpcap.dll not found - install Npcap from "
+                   "https://npcap.com (\"WinPcap API-compatible mode\")");
+        return false;
+    }
+#else
+    {
+        static const char *const names[] = {
+            "libpcap.so.1", "libpcap.so.0.8", "libpcap.so", "libpcap.dylib"
+        };
+        h = NULL;
+        for (int i = 0; i < ARRAY_SIZE(names) && !h; i++) {
+            h = dlopen(names[i], RTLD_NOW);
+        }
+    }
+#define SYM(n) dlsym(h, n)
+    if (!h) {
+        error_setg(errp, "pcap: libpcap not found (install libpcap0.8)");
+        return false;
+    }
+#endif
+#define LOAD(f, n) do { \
+        *(void **)&pc.f = (void *)SYM(n); \
+        if (!pc.f) { \
+            error_setg(errp, "pcap: symbol %s missing", n); \
+            return false; \
+        } \
+    } while (0)
+    LOAD(create, "pcap_create");
+    LOAD(set_snaplen, "pcap_set_snaplen");
+    LOAD(set_promisc, "pcap_set_promisc");
+    LOAD(set_timeout, "pcap_set_timeout");
+    LOAD(set_immediate_mode, "pcap_set_immediate_mode");
+    LOAD(activate, "pcap_activate");
+    LOAD(setnonblock, "pcap_setnonblock");
+    LOAD(next_ex, "pcap_next_ex");
+    LOAD(sendpacket, "pcap_sendpacket");
+    LOAD(close, "pcap_close");
+    LOAD(geterr, "pcap_geterr");
+    LOAD(findalldevs, "pcap_findalldevs");
+    LOAD(freealldevs, "pcap_freealldevs");
+#ifdef _WIN32
+    LOAD(getevent, "pcap_getevent");
+    LOAD(setmintocopy, "pcap_setmintocopy");
+#else
+    LOAD(get_selectable_fd, "pcap_get_selectable_fd");
+#endif
+#undef LOAD
+#undef SYM
+    pc.loaded = true;
+    return true;
+}
+
+typedef struct PcapState {
+    NetClientState nc;
+    pcap_t *p;
+    /* source MACs of frames we injected: filter them out on capture */
+    uint8_t sent_mac[RECENT_MACS][6];
+    unsigned sent_next;
+#ifdef _WIN32
+    HANDLE event;
+#else
+    int fd;
+#endif
+} PcapState;
+
+static bool is_own_mac(PcapState *s, const uint8_t *mac)
+{
+    for (int i = 0; i < RECENT_MACS; i++) {
+        if (!memcmp(s->sent_mac[i], mac, 6)) {
+            return true;
+        }
+    }
+    return false;
+}
+
+static void remember_mac(PcapState *s, const uint8_t *mac)
+{
+    if (!is_own_mac(s, mac)) {
+        memcpy(s->sent_mac[s->sent_next++ % RECENT_MACS], mac, 6);
+    }
+}
+
+static ssize_t pcap_receive(NetClientState *nc, const uint8_t *buf,
+                            size_t size)
+{
+    PcapState *s = DO_UPCAST(PcapState, nc, nc);
+
+    if (size >= 12) {
+        remember_mac(s, buf + 6);
+    }
+    if (pc.sendpacket(s->p, buf, size) < 0) {
+        /* e.g. adapter down: drop silently like a cable unplugged */
+        return size;
+    }
+    return size;
+}
+
+static void pcap_read(void *opaque)
+{
+    PcapState *s = opaque;
+    struct pcap_pkthdr *hdr;
+    const unsigned char *data;
+    int budget = 256;
+
+    while (budget-- && pc.next_ex(s->p, &hdr, &data) == 1) {
+        if (hdr->caplen < 14 || hdr->caplen != hdr->len) {
+            continue;
+        }
+        /* skip our own injected frames (looped back by the capture) */
+        if (is_own_mac(s, data + 6)) {
+            continue;
+        }
+        qemu_send_packet(&s->nc, data, hdr->caplen);
+    }
+}
+
+#ifdef _WIN32
+static void pcap_event(void *opaque)
+{
+    pcap_read(opaque);
+}
+#endif
+
+static void pcap_cleanup(NetClientState *nc)
+{
+    PcapState *s = DO_UPCAST(PcapState, nc, nc);
+
+    if (s->p) {
+#ifdef _WIN32
+        qemu_del_wait_object(s->event, pcap_event, s);
+#else
+        qemu_set_fd_handler(s->fd, NULL, NULL, NULL);
+#endif
+        pc.close(s->p);
+        s->p = NULL;
+    }
+}
+
+static NetClientInfo net_pcap_info = {
+    .type = NET_CLIENT_DRIVER_PCAP,
+    .size = sizeof(PcapState),
+    .receive = pcap_receive,
+    .cleanup = pcap_cleanup,
+};
+
+static void list_devices(void)
+{
+    pcap_if_t *all, *d;
+    char err[PCAP_ERRBUF_SIZE];
+    int i = 1;
+
+    if (pc.findalldevs(&all, err) < 0) {
+        error_report("pcap: %s", err);
+        return;
+    }
+    printf("pcap devices:\n");
+    for (d = all; d; d = d->next, i++) {
+        printf("  %2d  %s  (%s)\n", i, d->name,
+               d->description ? d->description : "");
+    }
+    pc.freealldevs(all);
+}
+
+static char *resolve_ifname(const char *ifname)
+{
+    pcap_if_t *all, *d;
+    char err[PCAP_ERRBUF_SIZE];
+    char *end;
+    long idx = strtol(ifname, &end, 10);
+    char *ret = NULL;
+
+    if (*ifname && !*end && idx > 0 && pc.findalldevs(&all, err) >= 0) {
+        for (d = all; d && --idx; d = d->next) {
+            /* walk */
+        }
+        if (d) {
+            ret = g_strdup(d->name);
+        }
+        pc.freealldevs(all);
+    }
+    return ret ? ret : g_strdup(ifname);
+}
+
+int net_init_pcap(const Netdev *netdev, const char *name,
+                  NetClientState *peer, Error **errp)
+{
+    const NetdevPcapOptions *opts = &netdev->u.pcap;
+    char err[PCAP_ERRBUF_SIZE] = "";
+    g_autofree char *dev = NULL;
+    NetClientState *nc;
+    PcapState *s;
+    pcap_t *p;
+    int ret;
+
+    if (!pcap_load(errp)) {
+        return -1;
+    }
+    if (!strcmp(opts->ifname, "list") || !strcmp(opts->ifname, "help")) {
+        list_devices();
+        exit(0);
+    }
+    dev = resolve_ifname(opts->ifname);
+
+    p = pc.create(dev, err);
+    if (!p) {
+        error_setg(errp, "pcap: cannot open %s: %s", dev, err);
+        return -1;
+    }
+    pc.set_snaplen(p, PCAP_SNAPLEN);
+    pc.set_promisc(p, 1);
+    pc.set_timeout(p, 1);
+    pc.set_immediate_mode(p, 1);
+    ret = pc.activate(p);
+    if (ret < 0) {
+        error_setg(errp, "pcap: cannot activate %s: %s (are you allowed to "
+                   "capture? Linux: root/CAP_NET_RAW, Windows: Npcap "
+                   "without admin-only restriction)", dev, pc.geterr(p));
+        pc.close(p);
+        return -1;
+    }
+    if (pc.setnonblock(p, 1, err) < 0) {
+        error_setg(errp, "pcap: setnonblock: %s", err);
+        pc.close(p);
+        return -1;
+    }
+
+    nc = qemu_new_net_client(&net_pcap_info, peer, "pcap", name);
+    s = DO_UPCAST(PcapState, nc, nc);
+    s->p = p;
+    qemu_set_info_str(nc, "pcap: %s", dev);
+
+#ifdef _WIN32
+    pc.setmintocopy(p, 0);
+    s->event = pc.getevent(p);
+    if (qemu_add_wait_object(s->event, pcap_event, s) < 0) {
+        error_setg(errp, "pcap: cannot register wait object");
+        return -1;
+    }
+#else
+    s->fd = pc.get_selectable_fd(p);
+    if (s->fd < 0) {
+        error_setg(errp, "pcap: no selectable fd for %s", dev);
+        return -1;
+    }
+    qemu_set_fd_handler(s->fd, pcap_read, NULL, s);
+#endif
+    return 0;
+}
