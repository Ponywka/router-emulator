+    EthPhy *p = n < 2 ? &s->dphy[n] : &s->p5phy;    /* 2: switch port 5 */
     bool reset = !level;    /* active low */
 
     if (p->in_reset && !reset) {
@@ -677,6 +737,9 @@ static EthPhy *mdio_find_phy(MT7981EthState *s, int addr, bool sw_internal)
             return s->dphy[g].in_reset ? NULL : &s->dphy[g];
