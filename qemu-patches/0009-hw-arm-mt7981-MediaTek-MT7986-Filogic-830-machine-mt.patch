 };
@@ -215,6 +239,12 @@ static void phy_init(EthPhy *p, int type, bool link)
         ht_set(p->mmd, (1 << 16) | 11, BIT(14));   /* EXTABLE: NBT */
         ht_set(p->mmd, (1 << 16) | 21, BIT(0));    /* NG_EXTABLE: 2.5GT */
         ht_set(p->mmd, (7 << 16) | 0x20, 0x0080);  /* adv 2.5G */
+    } else if (type == PHY_GPY211) {
+        p->c22[MII_PHYID1] = 0x67c9;
+        p->c22[MII_PHYID2] = 0xde10;
+        ht_set(p->mmd, (7 << 16) | 0x00, 0x3000);   /* AN enabled */
+        ht_set(p->mmd, (7 << 16) | 0x20, 0x0080);   /* adv 2.5G */
+        ht_set(p->mmd, (30 << 16) | 0x08, 0x1000);  /* SGMII AN enabled */
     } else if (type == PHY_RTL8221B) {
         p->c22[MII_PHYID1] = 0x001c;
         p->c22[MII_PHYID2] = 0xc849;
@@ -292,6 +322,16 @@ static uint16_t phy_c22_read(EthPhy *p, int reg)
             }
         }
     }
+    if (p->type == PHY_GPY211) {
+        switch (reg) {
+        case GPY_MIISTAT:   /* link, full duplex, 2500M */
+            return p->link ? (BIT(10) | BIT(3) | 4) : 0;
+        case GPY_FWV:       /* release firmware 8.111 */
+            return 0x886f;
+        case 0x1a:          /* ISTAT: nothing pending */
+            return 0;
+        }
+    }
     switch (reg) {
     case MII_BMSR:
         return MII_BMSR_100TX_FD | MII_BMSR_100TX_HD | MII_BMSR_10T_FD |
@@ -387,7 +427,19 @@ static uint16_t phy_c45_read(EthPhy *p, int dev, int reg)
 {
     uint16_t id1 = p->c22[MII_PHYID1], id2 = p->c22[MII_PHYID2];
 
-    if (p->type == PHY_RTL8221B) {
+    if (p->type == PHY_GPY211 && dev == 30) {
+        switch (reg) {
+        case GPY_VSPEC1_MBOX_CMD:   /* mailbox reads complete at once */
+            return ht_get(p->mmd, (30 << 16) | reg, 0) | BIT(15);
+        case GPY_VSPEC1_TEMP_STA: { /* ~45 C */
+            uint8_t r;
+            qemu_guest_getrandom_nofail(&r, 1);
+            return 392 + (r % 3);
+        }
+        }
+        return ht_get(p->mmd, (30 << 16) | reg, 0);
+    }
+    if (p->type == PHY_RTL8221B || p->type == PHY_GPY211) {
         switch (dev) {
         case 1:     /* PMA/PMD */
             switch (reg) {
@@ -530,8 +582,12 @@ static uint32_t sw_reg_read(MT7981EthState *s, uint32_t a)
         return 0x000004bf;
     case 0x7804:            /* MHWTRAP */
         return ht_get(s->sw, a, 0x000004bf);
