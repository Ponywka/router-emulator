     PHY_RTL8221B,       /* Realtek RTL8221B-VB-CG 2.5G */
     PHY_MT7981,         /* MT7981 built-in GbE PHY */
     PHY_YT8821,         /* Motorcomm YT8821 2.5G */
+    PHY_GPY211,         /* MaxLinear GPY211C 2.5G */
 };
 
+/* eth model PHY type numbers (properties) -> PHY_* */
+static const int phy_types[] = {
+    PHY_NONE, PHY_RTL8221B, PHY_MT7981, PHY_YT8821, PHY_GPY211,
+};
+
+static int phy_type(uint32_t n)
+{
+    return n < ARRAY_SIZE(phy_types) ? phy_types[n] : PHY_NONE;
+}
+
+/* GPY2xx registers */
+#define GPY_MIISTAT     0x18        /* c22: link, duplex, speed */
+#define GPY_FWV         0x1e        /* c22: firmware version */
+#define GPY_VSPEC1_MBOX_CMD 0x07    /* VEND1 mailbox command: [15] ready */
+#define GPY_VSPEC1_TEMP_STA 0x0e    /* VEND1 temperature sensor */
+
 /* YT8821 extended registers (reg 0x1e = address, 0x1f = data) */
 #define YT_EXT          (0x200 << 16)
 #define YT_SPACE_SEL    0xa000      /* bit 1: fiber/SerDes space */
@@ -111,7 +129,8 @@ typedef struct EthPort {
     MT7981EthState *s;
     NICState *nic;
     NICConf conf;
-    int index;          /* 0..4 switch ports, 5 + n = PHY on GMAC n */
+    int index;          /* 0..4 switch ports, 5 + n = PHY on GMAC n, */
+                        /* 7 = PHY on switch port 5 */
 } EthPort;
 
 typedef struct Pdma {
@@ -150,7 +169,12 @@ struct MT7981EthState {
     uint32_t switch_addr;
     bool has_switch;            /* MT7531 on GMAC0 */
 
-    EthPort ports[7];
