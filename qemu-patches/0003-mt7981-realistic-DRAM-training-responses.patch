From 81c0e983ce770b1855eff57f8be4878cd90a2f1a Mon Sep 17 00:00:00 2001
From: ultras <stavultras@gmail.com>
Date: Mon, 5 Oct 2026 16:11:27 -0400
Subject: [PATCH 3/6] mt7981: realistic DRAM training responses

Model the jitter meter (DQS clock edges every 48 delay cells), DQS
gating lead/lag around a preamble at UI 8 with the DDR4/DDR3 golden
DQS count (0x2323), and a read data eye (DQ-DQS within -30..+35 taps)
so the MediaTek DRAM calibration finds real windows and BL2 logs no
calibration errors.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 hw/arm/mt7981/mt7981_sysctl.c | 47 +++++++++++++++++++++++++++++++++--
 1 file changed, 45 insertions(+), 2 deletions(-)

diff --git a/hw/arm/mt7981/mt7981_sysctl.c b/hw/arm/mt7981/mt7981_sysctl.c
index 521cd44..104deed 100644
--- a/hw/arm/mt7981/mt7981_sysctl.c
+++ b/hw/arm/mt7981/mt7981_sysctl.c
@@ -98,16 +98,59 @@ static bool dramc_nao_read(MT7981SysctlState *s, hwaddr a, uint32_t *v)
             return true;
         }
     }
+    if (blk == 0 && (off == 0x120 || off == 0x124)) {
+        /*
+         * Test agent compare result.  Model a read data eye: with the
+         * RX DQ delay (PHY AO 0xa08) and DQS delay (0xa0c) currently
+         * programmed, all bits pass while DQ - DQS is within [-30, +35]
+         * taps and fail outside, so the RX window edges can be found.
+         */
+        hwaddr phy = (a & ~0xffffULL) + 0xa000;
+        int dq = reg_get(s, phy + 0xa08, 0) & 0x7f;
+        int dqs = reg_get(s, phy + 0xa0c, 0) & 0x7f;
+        bool pass = dq - dqs >= -30 && dq - dqs <= 35;
+        if (off == 0x124) {
+            *v = pass ? 0 : 0xffffffff;
+        } else {
+            /* DM_CMP_CPT_RK0/1, DLE_CNT_OK, DM_CMP_ERR_RK0/1 on failure */
+            *v = BIT(0) | BIT(1) | BIT(8) | BIT(9) |
+                 (pass ? 0 : (BIT(4) | BIT(5)));
+        }
+        return true;
+    }
+    if (blk == 1 && (off == 0x198 || off == 0x19c)) {
+        /*
+         * DQS gating lead/lag (STBEN).  BL2 sweeps the DQSIEN delay in
+         * PHY AO 0xa2c: UI in [7:0], PI in [20:16] (32 PI per UI).  Model
+         * the DQS preamble at UI 8: (0,0) before, (1,1) for 2 UI, a short
+         * (1,0) transition, then (0,0).
+         */
+        uint32_t d = reg_get(s, (a & ~0xffffULL) + 0xaa2c, 0);
+        uint32_t t = (d & 0xff) * 32 + ((d >> 16) & 0x1f);
+        const uint32_t t0 = 8 * 32;
+        if (t >= t0 && t < t0 + 64) {
+            *v = BIT(16) | BIT(17);
+        } else if (t >= t0 + 64 && t < t0 + 80) {
+            *v = BIT(16);
+        }
+        return true;
+    }
+    if (blk == 1 && (off == 0x500 || off == 0x504)) {
+        *v = 0x2323;    /* CAL_DQSG_CNT: golden DQS count (DDR4, div mode) */
+        return true;
+    }
     if (blk == 1 && (off == 0x224 || off == 0x228 || off == 0x22c)) {
         /*
          * Jitter meter: TOGGLE_CNT samples, DQSx_ERR_CNT = number of ones
-         * sampled.  Model a DQS clock with a period of 128 delay cells.
+         * sampled.  BL2 sweeps the delay 0..124 and needs two DQS edges:
+         * model tCK/2 = 48 delay cells (~8.7 ps/cell at DDR4-2400) with
+         * the first edge at 32 cells.
          */
         uint32_t dly = (reg_get(s, (a & ~0xffffULL) + 0xa524, 0) >> 16) & 0x1ff;
         if (off == 0x224) {
             *v = 1024;
         } else {
-            *v = ((dly / 64) & 1) ? 1024 : 0;
+            *v = (((dly + 16) / 48) & 1) ? 1024 : 0;
         }
         return true;
     }
